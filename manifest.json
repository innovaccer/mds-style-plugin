{
  "manifest_version": 3,
  "name": "Style Inspector",
  "version": "1.0.0",
  "author": "Anuradha Aggarwal",
  "description": "Inspects DOM elements for hardcoded CSS values and highlights them",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Style Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
} 